   "metadata": {},
   "outputs": [],
   "source": [
    "number = input();\n",
    "if number > 0:\n",
    "    print(\"Positive\");\n",
    "elif number < 0:\n",
    "    print(\"Negative\");\n",
    "else:\n",
    "    print(\"Zero\")"
   ]
  }
